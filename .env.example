# ===========================================
# MOTOSPORT TRACKING - Environment Variables
# העתק קובץ זה ל-.env.local ומלא את הערכים
# ===========================================

# Supabase Database — העתק מ-Dashboard → Connect → Transaction pooler (6543) ו-Session pooler (5432)
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# NextAuth — צור עם: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ShipsGo API — קבל מ-https://shipsgo.com/api
SHIPSGO_API_KEY="your-shipsgo-api-key-here"
SHIPSGO_BASE_URL="https://api.shipsgo.com/v2"

# Webhook secret — צור עם: openssl rand -hex 32
WEBHOOK_SECRET="replace-with-strong-random-secret"

# DEV ONLY — לפיתוח מקומי בלבד. לעולם לא לשים 1 בסביבת פרודקשן
DEV_BYPASS_AUTH=0
NEXT_PUBLIC_DEV_BYPASS_AUTH=0
